<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CombatTracker.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <ContentPage.Resources>
        <ResourceDictionary Source="src/Components/ParticipantList/ParticipantList.xaml" />
        <ResourceDictionary Source="src/Components/RoundTracker.xaml" />
    </ContentPage.Resources>
    <ScrollView>
        <HorizontalStackLayout>
            <ContentView BindingContext="{Binding ParticipantListViewModel}" ControlTemplate="{StaticResource ParticipantList}" />
            <ContentView BindingContext="{Binding RoundTrackerViewModel}" ControlTemplate="{StaticResource RoundTracker}" />
        </HorizontalStackLayout>
    </ScrollView>
</ContentPage>